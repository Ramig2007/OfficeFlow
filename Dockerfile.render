# Render Free / Neon: dedicated image, independent from the Docker Compose image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 officeflow

COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY . .
RUN mkdir -p /app/staticfiles && chown -R officeflow:officeflow /app

USER officeflow
EXPOSE 10000
CMD ["sh", "scripts/render-start.sh"]
