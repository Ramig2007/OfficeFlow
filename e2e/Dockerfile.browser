# Отдельный контейнер для браузерного тестирования OfficeFlow.
# Не пересобирает Django и не изменяет приложение или PostgreSQL.
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble
RUN python -m pip install --no-cache-dir "playwright==1.64.1"
WORKDIR /tests
COPY browser_smoke.py /tests/browser_smoke.py
CMD ["python", "/tests/browser_smoke.py"]
