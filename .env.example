# Copy to .env. Do not commit .env to Git.
DEBUG=1
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
DB_NAME=officeflow
DB_USER=officeflow
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/1
TIME_ZONE=Europe/Moscow
COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
DEMO_PASSWORD=REPLACE_WITH_DEMO_ONLY_PASSWORD
GRAFANA_USER=admin
GRAFANA_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

# Optional: Alertmanager-compatible HTTPS webhook; blank keeps notifications disabled.
ALERTMANAGER_WEBHOOK_URL=
# Optional bearer token for the webhook endpoint. Never commit a real token.
ALERTMANAGER_WEBHOOK_BEARER_TOKEN=

# Optional native Telegram receiver for Alertmanager. Keep real values only in local .env.
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=
