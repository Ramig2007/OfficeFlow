{
  "title": "OfficeFlow · Reliability", "uid": "officeflow-reliability", "tags": ["officeflow"],
  "schemaVersion": 39, "version": 1, "refresh": "15s", "timezone": "browser",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "HTTP RPS", "gridPos": {"x":0,"y":0,"w":12,"h":8}, "datasource":{"type":"prometheus","uid":"officeflow-prom"}, "targets":[{"expr":"sum(rate(django_http_requests_before_middlewares_total[5m]))","refId":"A","legendFormat":"RPS"}]},
    {"id": 2, "type": "timeseries", "title": "HTTP p95 latency (seconds)", "gridPos": {"x":12,"y":0,"w":12,"h":8}, "datasource":{"type":"prometheus","uid":"officeflow-prom"}, "targets":[{"expr":"histogram_quantile(0.95, sum by(le) (rate(django_http_requests_latency_including_middlewares_seconds_bucket[5m])))","refId":"A","legendFormat":"p95"}]},
    {"id": 3, "type": "timeseries", "title": "5xx error rate", "gridPos": {"x":0,"y":8,"w":12,"h":8}, "datasource":{"type":"prometheus","uid":"officeflow-prom"}, "targets":[{"expr":"sum(rate(django_http_responses_total_by_status_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(django_http_responses_total_by_status_total[5m])),0.01)","refId":"A","legendFormat":"error rate"}]},
    {"id": 4, "type": "timeseries", "title": "Infrastructure availability", "gridPos": {"x":12,"y":8,"w":12,"h":8}, "datasource":{"type":"prometheus","uid":"officeflow-prom"}, "targets":[{"expr":"up{job=~\"officeflow|postgres|redis\"}","refId":"A","legendFormat":"{{job}}"}]}
  ]
}
