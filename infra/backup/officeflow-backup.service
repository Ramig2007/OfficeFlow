[Unit]
Description=OfficeFlow PostgreSQL backup to encrypted off-site S3 storage
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/officeflow
EnvironmentFile=/etc/officeflow-backup.env
Environment=BACKUP_DIR=/var/backups/officeflow
ExecStart=/usr/bin/bash /opt/officeflow/scripts/backup-offsite.sh
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/officeflow /run/docker.sock
