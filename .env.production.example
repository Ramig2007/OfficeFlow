# Production environment template for OfficeFlow.
# Copy to .env on the VPS, replace every placeholder, and chmod 600 .env.
# Never commit the real .env file.

DEBUG=0
SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS

DOMAIN=officeflow.example.com
ALLOWED_HOSTS=officeflow.example.com
CSRF_TRUSTED_ORIGINS=https://officeflow.example.com

DB_NAME=officeflow
DB_USER=officeflow
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/1

TIME_ZONE=Europe/Moscow
COOKIE_SECURE=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
SECURE_REFERRER_POLICY=same-origin

# Required if the observability profile is enabled.
GRAFANA_USER=officeflow-operator
GRAFANA_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
